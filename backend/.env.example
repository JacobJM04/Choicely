# Copy to backend/.env (gitignored) or export these before running uvicorn.

# Turns the Claude seam on: the grounded debrief, the agent's check-in
# phrasing + backlog triage, the weekly reflection, classification, the
# game-theory breakdown, and the crisis screen all switch from heuristics
# to the real API. Everything runs without it.
ANTHROPIC_API_KEY=

# Model for every Claude call. Defaults to claude-sonnet-5 (fast, cheap
# enough to leave on for a live demo). Set to claude-opus-5 for a judged run.
CHOICELY_LLM_MODEL=claude-sonnet-5

# Force the heuristic path even with a key present (keeps a public demo's
# spend at exactly zero). Unset / 0 = use Claude when the key is there.
CHOICELY_LLM_DISABLED=0

# SQLite path + data dir (VAPID keypair). Fine to leave unset for local dev.
# CHOICELY_DB=./data/choicely.db
# CHOICELY_DATA=./data

# 1 (default) keeps POST /demo/advance (the time-travel control) enabled.
CHOICELY_DEMO=1
